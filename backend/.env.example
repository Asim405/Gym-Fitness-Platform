# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://gym_user:gym_password@localhost:5432/gym_fitness_db
# If not using DATABASE_URL, individual vars are also supported:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gym_fitness_db
DB_USER=gym_user
DB_PASSWORD=gym_password

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10
